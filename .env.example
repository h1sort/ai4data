# Copia este archivo a .env (sin "ejemplo") y deja activa UNA opción.
# Precios: USD por millón de tokens, de la página de precios de tu proveedor (0 en local).

# Opción A · local con Ollama (gratis, tus datos no salen de tu laptop)
#   ollama pull qwen3:1.7b   -> 1.4 GB, cuantizado a 4 bits: corre en casi cualquier laptop
#   ollama pull qwen3:0.6b   -> 523 MB, si tu máquina tiene muy poca memoria
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:1.7b
LLM_API_KEY=
LLM_PRECIO_ENTRADA=0
LLM_PRECIO_SALIDA=0

# Opción B · OpenAI con tu llave (platform.openai.com)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6-luna
# LLM_API_KEY=pega-aqui-tu-llave
# LLM_PRECIO_ENTRADA=
# LLM_PRECIO_SALIDA=

# Opción C · Anthropic con tu llave (platform.claude.com)
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-haiku-5-5
# LLM_API_KEY=pega-aqui-tu-llave
# LLM_PRECIO_ENTRADA=
# LLM_PRECIO_SALIDA=
