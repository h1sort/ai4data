# Copia este archivo a .env (sin "ejemplo") y deja activa UNA de las dos opciones.

# Opción A · remoto: Inkling 2 Mini en OpenRouter (necesitas una llave de openrouter.ai)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=thinkingmachines/inkling-2-mini
LLM_API_KEY=pega-aqui-tu-llave
# precios en USD por millón de tokens: cópialos de la página del modelo en openrouter.ai
LLM_PRECIO_ENTRADA=
LLM_PRECIO_SALIDA=

# Opción B · local: Ollama en tu computadora (sin llave, sin costo)
#   8 GB de RAM  -> qwen3:1.7b   (1.4 GB)
#   16 GB de RAM -> qwen3:4b     (2.5 GB)
#   Mac de 32 GB -> inkling-2-mini (~20 GB)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=
# LLM_PRECIO_ENTRADA=0
# LLM_PRECIO_SALIDA=0
